{
  "rules": {
    "feed": {
      "$uid": {
        ".read": "auth.uid === $uid",
        ".write": "auth.uid === $uid",
        "$postId": {
          ".validate": "newData.val() === true && newData.parent().parent().parent().child('posts').child($postId).exists()"
        }
      }
    },
    "posts": {
      ".read": true,
      ".indexOn": ["author/uid", "title"], // Allow searching for posts by authors and title
      "$postId": {
        ".write": "!data.exists() || data.exists() && auth.uid === data.child('author').child('uid').val()", // Allow new writes and allow updates and deletes to own posts.
        "author": {
          "uid": {
            ".validate": "auth.uid === newData.val()"
          }
        }
      }
    },
    "activity": {
      ".read": true,
      ".indexOn": ["event_timestamp", "postId"],
      "$uid": {
        ".write": "auth.uid === $uid",
        "$activityId": {
          "postId": {
            ".validate": "root.child('posts').child(newData.val()).exists()"
          },
          "uid": {
            ".validate": "auth.uid === newData.val()"
          }
        }
      }
    },
    "discover": {
      "$uid": {
        ".indexOn": ["event_timestamp"],
        ".read": "auth.uid === $uid",
        ".write": "auth.uid === $uid",
        "$postId": {
          ".validate": "root.child('posts').child($postId).exists()",
          "uid": {
            // make sure the records here are only for people you follow
            ".validate": "root.child('people').child(auth.uid).child('following').child(newData.val()).exists()"
          }
        }
      }
    },
    "comments": {
      ".read": true,
      "$postId": {
        ".write": "!newData.exists() && auth.uid === root.child('posts').child($postId).child('author').child('uid').val() && !newData.parent().parent().child('posts').child($postId).exists()", // Allow deletes from the post owner
        ".validate": "root.child('posts').child($postId).exists()", // Check that the post exists
        "$commentId": {
          ".write": "!data.exists() || data.exists() && auth.uid === data.child('author').child('uid').val()",  // Can write new comments and edit/delete particular comment if you are the author.
          "author": {
            "uid": {
              ".validate": "auth.uid === newData.val()"
            }
          }
        }
      }
    },
    "likes": {
      ".read": true,
      "$postId": {
        ".write": "!newData.exists() && !newData.parent().parent().child('posts').child($postId).exists()", // Allow deletes from the post owner
        ".validate": "root.child('posts').child($postId).exists()", // Check that the post exists
        "$uid": {
          ".write": "auth.uid === $uid",
          ".validate": "newData.val() === now"
        }
      }
    },
    "attends_post": {
      ".read": true,
      "$postId": {
        ".write": "!newData.exists() && !newData.parent().parent().child('posts').child($postId).exists()", // Allow deletes from the post owner
        ".validate": "root.child('posts').child($postId).exists()", // Check that the post exists
        "$uid": {
          ".write": "auth.uid === $uid",
          ".validate": "newData.val() >= now" // can only attend events in the future
        }
      }
    },
    "attends_user": {
      ".read": true,
      "$uid": {
        ".write": "auth.uid === $uid",
        ".validate": "true",
        "$postId": {
          ".write": "!newData.exists() && !newData.parent().parent().child('posts').child($postId).exists()",
          ".validate": "root.child('posts').child($postId).exists()"
        }
      }
    },
    "followers": {
      ".read": true,
      "$followedUid": {
        "$followerUid": {
          ".write": "auth.uid !== $followedUid", // Cannot follow yourself
          ".validate": "newData.val() === true" // Makes sure /people/.../following is in sync
        }
      }
    },
    "people": {
      ".indexOn": ["username", "_search_index/full_name", "_search_index/reversed_full_name"],
      ".read": true,
      "$uid": {
        ".write": "auth.uid === $uid",
        "full_name": {
          ".validate": "newData.isString()"
        },
        "profile_picture": {
          ".validate": "newData.isString()"
        },
        "posts": {
          "$postId": {
            ".validate": "newData.val() === true && newData.parent().parent().parent().parent().child('posts').child($postId).exists()"
          }
        },
        "_search_index": {
          "full_name": {
            ".validate": "newData.isString()"
          },
          "reversed_full_name": {
            ".validate": "newData.isString()"
          }
        },
        "following": {
          "$followedUid": {
            "activity": {
              ".validate": "root.child('activity').child($followedUid).child(newData.val()).exists()"
            },
            "posts": {
              ".validate": "root.child('followers').child($followedUid).child($uid).val() === true" // Makes sure /followers is in sync
            }
          }
        }
      }
    },
    "notifications": {
      ".read": true,
      "$uid": {
        "$notificationId": {
          ".write": "root.child('people').child($uid).exists()"
        }
      }
    },
    "$other": {
      ".validate": false
    }
  }
}
